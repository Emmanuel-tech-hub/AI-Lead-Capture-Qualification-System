      "name": "Wait 60 Seconds",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        1760,
        300
      ],
      "webhookId": "9f6f1712-a0a8-470f-a3c5-181ecaff15ab"
    },
    {
      "parameters": {
        "url": "={{ $('Save Job ID').first().json.statusUrl }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 60000
        }
      },
      "id": "4a736f9d-5703-4e17-8c5d-91fc5f122d82",
      "name": "Check Video Status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1980,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Works with most video APIs: finds the status word and the finished video URL wherever they are.\nconst r = $input.first().json;\nconst job = $('Save Job ID').first().json;\n\nfunction findVideoUrl(obj, depth = 0) {\n  if (!obj || depth > 6) return null;\n  if (typeof obj === 'string') {\n    return /^https?:\\/\\/\\S+\\.(mp4|mov|webm)(\\?\\S*)?$/i.test(obj) ? obj : null;\n  }\n  if (Array.isArray(obj)) { for (const v of obj) { const u = findVideoUrl(v, depth + 1); if (u) return u; } return null; }\n  for (const [k, v] of Object.entries(obj)) {\n    if (typeof v === 'string' && /video|output|url/i.test(k) && /^https?:\\/\\//.test(v) && !/status|cancel|logs/i.test(k)) {\n      if (/\\.(mp4|mov|webm)/i.test(v) || /video/i.test(k)) return v;\n    }\n    const u = findVideoUrl(v, depth + 1); if (u) return u;\n  }\n  return null;\n}\n\nconst status = String(r.status ?? r.state ?? r.data?.status ?? r.data?.state ?? '').toLowerCase();\nconst videoUrl = findVideoUrl(r);\nconst attempt = $runIndex + 1;\nconst max = Number(job.cfg.maxPollAttempts || 20);\n\nlet state = 'pending';\nif (['failed', 'error', 'canceled', 'cancelled', 'nsfw', 'rejected'].includes(status)) state = 'failed';\nelse if (videoUrl && (['completed', 'succeeded', 'success', 'done', 'finished', 'ready', ''].includes(status) || !status)) state = 'ready';\nelse if (attempt >= max) state = 'failed';\n\nreturn [{ json: { ...job, state, videoUrl, providerStatus: status || 'unknown', attempt,\n  failReason: state === 'failed' ? (attempt >= max ? 'Timed out after ' + attempt + ' checks' : 'Provider status: ' + status) : null } }];\n"
      },
      "id": "1304d4f8-4529-4329-90c1-907f8d7c9288",
      "name": "Read Video Status",
      "type": "n8n-nodes-base.code",
