      "id": "42be589c-e1cb-4291-b708-1aa6f635bf00",
      "name": "Review & Edit (Telegram)",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        3080,
        140
      ],
      "webhookId": "ff20edb5-c8ab-40eb-aaf3-2d1441462775"
    },
    {
      "parameters": {
        "jsCode": "// Uses your edits when you typed them, otherwise keeps the AI text.\nconst form = $input.first().json || {};\nconst d = form.data || form;\nconst pick = (label) => {\n  const v = d[label] ?? d[label.toLowerCase()] ?? d[label.replace(/\\s+/g, '_').toLowerCase()];\n  return typeof v === 'string' ? v.trim() : '';\n};\nconst v = $('Read Video Status').first().json;\n\nlet decision = pick('Decision') || 'No response';\nconst newTitle = pick('New Title');\nconst newDescription = pick('New Description');\n\nconst finalTitle = (newTitle || v.title).slice(0, 100);\nconst finalDescription = (newDescription || v.description).slice(0, 4900);\nconst approved = decision.startsWith('Approve');\n\nreturn [{ json: { ...v, decision, approved: approved ? 'yes' : 'no', finalTitle, finalDescription,\n  edited: Boolean(newTitle || newDescription) } }];\n"
      },
      "id": "64710ec5-a9c4-4f77-ba71-f21c91d03ba1",
      "name": "Apply My Edits",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3300,
        140
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "006d5f28-019b-4e39-b845-2962addc0cd7",
              "leftValue": "={{ $json.approved }}",
