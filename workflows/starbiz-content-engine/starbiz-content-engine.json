        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  model: $json.cfg.videoModel,\n  prompt: $json.videoPrompt,\n  aspect_ratio: $json.cfg.aspectRatio,\n  duration: $json.cfg.videoSeconds\n}) }}",
        "options": {
