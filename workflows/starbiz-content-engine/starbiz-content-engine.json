    {
      "parameters": {
        "jsCode": "// Remembers the video job ID so we can check on it.\nconst r = $input.first().json;\nconst id = r.id ?? r.job_id ?? r.request_id ?? r.task_id ?? r.data?.id ?? r.data?.job_id ?? r.generation_id;\nif (!id && !r.status_url) throw new Error('Could not find a job id in the video API response: ' + JSON.stringify(r).slice(0, 500));\nconst s = $('Parse Script').first().json;\nconst statusUrl = r.status_url || s.cfg.videoStatusUrlTemplate.replace('{id}', id);\nreturn [{ json: { ...s, jobId: id || null, statusUrl } }];\n"
      },
      "id": "ad330300-65f6-4c23-83a3-27ffd9be0f9b",
      "name": "Save Job ID",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
