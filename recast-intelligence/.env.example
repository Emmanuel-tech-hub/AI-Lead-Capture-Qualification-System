# Copy this file to .env and fill it in. .env is git-ignored: never commit it.

# Claude API key (console.anthropic.com -> API Keys). Leave empty to run without AI (keyword ranking only).
ANTHROPIC_API_KEY=

# Where the newsletter goes
RECAST_EMAIL_TO=you@example.com
RECAST_EMAIL_FROM=you@example.com

# SMTP server. Gmail: smtp.gmail.com / 587 / your Gmail address / a 16-character App Password
RECAST_SMTP_HOST=smtp.gmail.com
RECAST_SMTP_PORT=587
RECAST_SMTP_USER=you@example.com
RECAST_SMTP_PASSWORD=
